# Supabase session pooler connection string (Settings > Database). Never commit the real value.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
GRACE_PERIOD_SECONDS=15
REMINDER_INTERVAL_SECONDS=15
# How long the simulated voice call rings before "no answer"
VOICE_CALL_RING_SECONDS=2
CONTINUOUS_WATER_SECONDS=45
HIGH_POWER_SECONDS=45
HIGH_POWER_ABOVE_STANDBY_KW=1.0
CONTROLLABLE_UNIT_ID=A-105
# Relative paths are resolved from the backend/ directory
SEED_FILE=../shared/seed.json
# Comma-separated list
CORS_ORIGINS=http://localhost:5173
# Local time for activity schedules and reason-line clock times
DEMO_TIMEZONE=Asia/Kuala_Lumpur
# Same-hour neighbours: minimum outing overlap to match, and the "early riser" cut-off (local)
NEIGHBOUR_MIN_OVERLAP_MINUTES=30
NEIGHBOUR_EARLY_RISER_BEFORE=06:30
